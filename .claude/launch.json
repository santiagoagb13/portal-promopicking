{
	"version": "0.0.1",
	"configurations": [
		{
			"name": "portal-dev",
			"runtimeExecutable": "npm",
			"runtimeArgs": ["run", "dev"],
			"port": 5173
		},
		{
			"name": "portal-demo",
			"runtimeExecutable": "env",
			"runtimeArgs": [
