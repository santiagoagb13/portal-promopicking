# Portal de servicio Promopicking · variables de entorno (anexo B del plan).
# Copia este fichero a .env para desarrollo. En Vercel se definen en Project › Settings › Environment Variables.

# --- Base de datos ---
# Local: el Postgres 16 de compose.yaml. Vercel: cadena con pooler de Neon (…-pooler…/neondb?sslmode=require).
DATABASE_URL=postgres://portal:portal@localhost:5433/portal
# Conexiones máximas del pool por instancia (en Vercel conviene 3–5).
DATABASE_POOL_MAX=10

# --- Acceso ---
# Clave de firma de sesiones y cookies: 32+ caracteres aleatorios (openssl rand -base64 32). Distinta por entorno.
AUTH_SECRET=
# Origen público del portal, sin barra final. Define también el rpID de WebAuthn (passkeys):
# las passkeys quedan ligadas a este dominio y no sirven en otro.
AUTH_ORIGIN=http://localhost:5173

# --- Correo ---
# resend | smtp. Vacío solo en desarrollo: los correos se escriben en consola y en .mail/outbox.jsonl.
MAIL_PROVIDER=
MAIL_FROM="Portal Promopicking <portal@ejemplo.com>"
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Carpeta de la bandeja de desarrollo (solo sin MAIL_PROVIDER).
MAIL_OUTBOX_DIR=.mail

# --- Ficheros (artes finales, páginas, actas) ---
# local | s3. Vacío = local (disco, carpeta STORAGE_LOCAL_DIR). En Vercel hace falta s3 (ver ADR 0007).
STORAGE_PROVIDER=
STORAGE_LOCAL_DIR=.storage
# S3 compatible (AWS S3, Cloudflare R2, Hetzner Object Storage, MinIO). Estilo ruta: <endpoint>/<bucket>/<clave>.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_KEY=
S3_SECRET=
# Solo VPS con adapter-node y almacenamiento local: tamaño máximo del cuerpo de las peticiones (subida de PDF).
BODY_SIZE_LIMIT=60M

# --- Observabilidad (fase 7) ---
SENTRY_DSN=

# --- Interfaz ---
PUBLIC_APP_NAME="Portal de servicio"

# --- Solo desarrollo, pruebas y previsualización ---
# Fecha de referencia de los datos de prueba: los «hace 3 días» cuadran con el prototipo.
# Vacía en producción (se usa la fecha real).
APP_REFERENCE_DATE=2026-10-22
# Ruta al prototipo para el seed (si no existe, se usa la instantánea scripts/data/prototype.json).
PROTOTYPE_HTML=../portal/portal.html
# ADAPTER=node compila para el VPS (adapter-node, carpeta build/). Vacío = Vercel.
ADAPTER=
