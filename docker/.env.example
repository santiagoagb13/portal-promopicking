# Copia este fichero a docker/.env en el servidor y rellénalo. No lo subas al repositorio.

# Dominio público del portal (registro A/AAAA apuntando al VPS) y correo para Let's Encrypt.
PORTAL_DOMAIN=portal.ejemplo.com
ACME_EMAIL=sistemas@ejemplo.com
# Versión de la imagen (etiqueta de git, p. ej. v1.0.0).
PORTAL_VERSION=v1.0.0

# Postgres del propio servidor: contraseña larga y aleatoria (openssl rand -base64 24).
POSTGRES_PASSWORD=

# Acceso: 32+ caracteres aleatorios (openssl rand -base64 32), distinta de la de Vercel.
AUTH_SECRET=

# Correo: resend o smtp (ver .env.example de la raíz).
MAIL_PROVIDER=smtp
MAIL_FROM="Portal Promopicking <portal@ejemplo.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
RESEND_API_KEY=

# Ficheros: local (volumen «ficheros», recomendado) o s3 (almacenamiento de objetos del proveedor,
# p. ej. Hetzner Object Storage o Cloudflare R2; necesita CORS para PUT desde PORTAL_DOMAIN).
STORAGE_PROVIDER=local
# Solo con s3:
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_KEY=
S3_SECRET=

# Errores (opcional): Sentry o GlitchTip.
SENTRY_DSN=

# Copias de seguridad (docker/copia.sh): clave de cifrado y destino externo de rclone (opcional).
BACKUP_PASSPHRASE=
BACKUP_RCLONE_REMOTE=
