{
	"name": "portal-promopicking",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync && husky || true",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "npm run test:unit && npm run test:integration && npm run test:e2e",
		"test:unit": "vitest run --project unit",
		"test:e2e": "playwright test",
		"db:up": "docker compose up -d --wait",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "node --env-file-if-exists=.env --import tsx scripts/migrate.ts",
		"db:seed": "TSX_TSCONFIG_PATH=scripts/tsconfig.json node --env-file-if-exists=.env --import tsx scripts/seed-from-prototype.ts",
		"db:studio": "drizzle-kit studio",
		"seed:extract": "TSX_TSCONFIG_PATH=scripts/tsconfig.json node --env-file-if-exists=.env --import tsx scripts/seed-from-prototype.ts --solo-extraer",
		"icons": "node --env-file-if-exists=.env --import tsx scripts/generate-icons.ts",
		"test:integration": "vitest run --project integration",
		"vercel-build": "npm run db:migrate && if [ \"$VERCEL_ENV\" = \"preview\" ] || [ \"$PORTAL_DEMO\" = \"1\" ]; then npm run db:seed; fi && npm run build",
		"test:demo": "playwright test -c playwright.demo.config.ts",
		"build:node": "ADAPTER=node vite build",
		"start:node": "node build",
		"invitar-admin": "TSX_TSCONFIG_PATH=scripts/tsconfig.json node --env-file-if-exists=.env --import tsx scripts/invitar-admin.ts"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.10.2",
		"@eslint/js": "^10.0.1",
		"@fontsource-variable/geist": "^5.3.0",
		"@fontsource-variable/geist-mono": "^5.3.0",
		"@lucide/svelte": "^1.62.0",
		"@playwright/test": "^1.64.1",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/adapter-vercel": "^6.3.4",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/d3-scale": "^4.0.9",
		"@types/d3-shape": "^3.1.7",
		"@types/node": "^22.20.5",
		"@types/pg": "^8.23.1",
		"@types/qrcode": "1.5.5",
		"drizzle-kit": "^0.31.11",
		"eslint": "^10.13.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.13.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"sharp": "^0.35.5",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.7",
		"tailwindcss": "^4.3.3",
		"tslib": "^2.8.1",
		"tsx": "^4.23.15",
		"typescript": "~5.9.3",
		"typescript-eslint": "^8.72.1",
		"vite": "^8.3.5",
		"vitest": "^5.0.5"
	},
	"dependencies": {
		"@better-auth/passkey": "^1.7.14",
		"@napi-rs/canvas": "1.0.11",
		"@simplewebauthn/browser": "^13.3.0",
		"aws4fetch": "1.0.20",
		"better-auth": "^1.7.14",
		"d3-scale": "^4.0.2",
		"d3-shape": "^3.2.0",
		"drizzle-orm": "^0.45.4",
		"pdf-lib": "1.17.1",
		"pdfjs-dist": "6.4.299",
		"pg": "^8.23.1",
		"qrcode": "1.5.4",
		"read-excel-file": "9.3.12",
		"write-excel-file": "4.1.1",
		"zod": "^4.6.7",
		"zxing-wasm": "3.1.4"
	},
	"lint-staged": {
		"*.{ts,js,svelte}": [
			"prettier --write",
			"eslint --fix"
		],
		"*.{css,json,md,yml,yaml}": "prettier --write"
	}
}
